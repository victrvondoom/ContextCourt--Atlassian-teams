{
  "name": "contextcourt-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ContextCourt AI — evidence-driven decision intelligence for Atlassian teams.",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "vite build",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "vite-node scripts/demo-scenarios.ts",
    "validate:registers": "node scripts/validate-registers.mjs",
    "build:registers": "node scripts/author-registers.mjs && node scripts/validate-registers.mjs"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^5.5.0",
    "@forge/kvs": "^2.1.1",
    "@forge/resolver": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
